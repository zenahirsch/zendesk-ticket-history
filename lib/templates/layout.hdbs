<!-- {{htmlWebpackPlugin.options.warning}} -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    {{#each htmlWebpackPlugin.options.vendorCss}}
      <link href="{{this}}" rel="stylesheet">
    {{/each}}
  </head>
  <body>
    <section data-main></section>
    <div id="footer" class="text-center small" style="margin-top:2em;">
      <a href="https://github.com/zenahirsch/zendesk-ticket-history/issues/new" target="_blank" rel="noopener noreferrer">Share Feedback</a>
      <br />
      App version: banana
    </div>
    {{#each htmlWebpackPlugin.options.vendorJs}}
      <script type="text/javascript" src="{{this}}"></script>
    {{/each}}
  </body>
</html>
